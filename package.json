{
	"name": "@wolfstar-project/cdn-worker-r2",
	"version": "0.0.1",
	"private": true,
	"type": "module",
	"scripts": {
		"build": "vite build",
		"deploy": "nitro deploy --prebuilt",
		"dev": "vite dev",
		"lint:fix": "oxlint --fix && oxfmt",
		"lint": "oxlint && oxfmt --check",
		"prepare": "node .husky/install.mjs",
		"preview": "node .output/server/index.mjs",
		"typecheck": "tsc --noEmit"
	},
	"dependencies": {
		"@vite-hub/blob": "^0.0.3",
		"evlog": "^2.28.1",
		"nitro": "^3.0.260415-beta"
	},
	"devDependencies": {
		"@commitlint/cli": "21.2.2",
		"@commitlint/config-conventional": "21.2.2",
		"husky": "^9.1.7",
		"jiti": "^2.7.0",
		"nano-staged": "^1.0.2",
		"oxfmt": "^0.66.0",
		"oxlint": "^1.81.0",
		"typescript": "^5.9.2",
		"vite": "^8.2.2",
		"wrangler": "^4.128.0"
	},
	"nano-staged": {
		"*.{js,ts,mjs,cjs}": [
			"pnpm oxlint --fix"
		],
		"*.{js,ts,mjs,cjs,json,yml,md}": [
			"pnpm oxfmt"
		]
	},
	"packageManager": "pnpm@10.34.5"
}
