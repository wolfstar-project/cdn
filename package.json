{
	"name": "@wolfstar-project/cdn-worker-r2",
	"version": "0.0.1",
	"private": true,
	"type": "module",
	"scripts": {
		"build": "vite build",
		"deploy": "nitro deploy --prebuilt",
		"dev": "vite dev",
		"lint:fix": "oxlint --fix && oxfmt",
		"lint": "oxlint && oxfmt --check",
		"prepare": "node .husky/install.mjs",
		"preview": "node .output/server/index.mjs",
		"typecheck": "tsc --noEmit"
	},
	"dependencies": {
		"@vite-hub/blob": "^0.0.1",
		"evlog": "^2.17.0",
		"nitro": "^3.0.260415-beta"
	},
	"devDependencies": {
		"@commitlint/cli": "21.2.1",
		"@commitlint/config-conventional": "21.2.0",
		"husky": "^9.1.7",
		"jiti": "^2.7.0",
		"nano-staged": "^1.0.2",
		"oxfmt": "^0.51.0",
		"oxlint": "^1.66.0",
		"typescript": "^5.9.2",
		"vite": "^8.0.14",
		"wrangler": "^4.94.0"
	},
	"nano-staged": {
		"*.{js,ts,mjs,cjs}": [
			"pnpm oxlint --fix"
		],
		"*.{js,ts,mjs,cjs,json,yml,md}": [
			"pnpm oxfmt"
		]
	},
	"packageManager": "pnpm@11.25.0"
}
